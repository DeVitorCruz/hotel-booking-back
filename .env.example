APP_NAME="Hotel Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel
DB_USERNAME=hotel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Angular frontend (CORS + links in emails) -----------------------------
FRONTEND_URL=http://localhost:4200

# --- Hotel (per client) ----------------------------------------------------
HOTEL_NAME="Demo Hotel"
HOTEL_EMAIL=reservations@example.com
HOTEL_PHONE=
HOTEL_ADDRESS=
HOTEL_TIMEZONE=UTC
HOTEL_CURRENCY=USD
HOTEL_CHECK_IN_TIME=14:00
HOTEL_CHECK_OUT_TIME=11:00
HOTEL_TAX_PERCENT=0
HOTEL_DEPOSIT_PERCENT=100
HOTEL_MIN_NIGHTS=1
HOTEL_MAX_NIGHTS=30
HOTEL_MAX_ADVANCE_DAYS=365
HOTEL_HOLD_MINUTES=15
HOTEL_CANCELLATION_HOURS=48
HOTEL_AUTO_REFUND_ON_CANCEL=true
HOTEL_PAYMENT_METHODS=paypal,pay_at_hotel

# --- PayPal (https://developer.paypal.com → Apps & Credentials) ------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- First install ---------------------------------------------------------
OWNER_NAME="Hotel Owner"
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
SEED_DEMO_HOTEL=true
